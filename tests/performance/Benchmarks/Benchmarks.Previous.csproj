<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);JROC_PREVIOUS</DefineConstants>
    <JrocPackageVersion Condition="'$(JrocPackageVersion)' == ''">$(JROC_PREVIOUS_PACKAGE_VERSION)</JrocPackageVersion>
  </PropertyGroup>

  <Target Name="ValidateJrocPackageVersion"
          BeforeTargets="CollectPackageReferences"
          Condition="'$(JrocPackageVersion)' == ''">
    <Error Text="Set JrocPackageVersion to the published JROC version used by JrocPrevious." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Jint" Version="4.16.0" />
    <PackageReference Include="Okojo" Version="0.1.2-preview.1" />
    <PackageReference Include="YantraJS.Core" Version="1.2.418" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1" />
    <PackageReference Include="Jroc.Core" Version="$(JrocPackageVersion)" />
    <PackageReference Include="Jroc.Runtime" Version="$(JrocPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="PreviousProgram.cs" />
    <Compile Include="BenchmarkScenarioCatalog.cs" />
    <Compile Include="DromaeoExecutionBenchmarks.cs" />
    <Compile Include="ExecutionBenchmarksBase.cs" />
    <Compile Include="FullParamsConfig.cs" />
    <Compile Include="JavaScriptRuntimeBenchmarks.cs" />
    <Compile Include="JrocBenchmarkLabels.cs" />
    <Compile Include="KrackenBenchmarkSelection.cs" />
    <Compile Include="KrackenExecutionBenchmarks.cs" />
    <Compile Include="PrimeExecuteBenchmark.cs" />
    <Compile Include="Runtimes\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scenarios\**\*.js" CopyToOutputDirectory="PreserveNewest" LinkBase="Scenarios" />
  </ItemGroup>

</Project>
