<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(DotNet11Comparison)' != 'true'">net10.0</TargetFramework>
    <TargetFrameworks Condition="'$(DotNet11Comparison)' == 'true'">net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UsePublishedJrocPackages Condition="'$(UsePublishedJrocPackages)' == ''">false</UsePublishedJrocPackages>
    <DefineConstants Condition="'$(UsePublishedJrocPackages)' != 'true'">$(DefineConstants);SOURCE_JROC_PROJECTS</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidatePublishedJrocPackageVersion"
          BeforeTargets="CollectPackageReferences"
          Condition="'$(UsePublishedJrocPackages)' == 'true' and '$(JrocPackageVersion)' == ''">
    <Error Text="Set JrocPackageVersion when UsePublishedJrocPackages=true." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Jint" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="SharpTS.Hosting" />
    <PackageReference Include="Okojo" />
    <PackageReference Include="YantraJS.Core" />
    <PackageReference Include="Microsoft.ClearScript.V8" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PreviousProgram.cs" />
    <None Include="Scenarios\**\*.js" CopyToOutputDirectory="PreserveNewest" LinkBase="Scenarios" />
  </ItemGroup>

  <Choose>
    <When Condition="'$(UsePublishedJrocPackages)' == 'true'">
      <ItemGroup>
        <PackageReference Include="Jroc.Core" VersionOverride="$(JrocPackageVersion)" />
        <PackageReference Include="Jroc.Runtime" VersionOverride="$(JrocPackageVersion)" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <ProjectReference Include="..\..\..\src\Jroc.Core\Jroc.Core.csproj" />
        <ProjectReference Include="..\..\..\src\JavaScriptRuntime\JavaScriptRuntime.csproj" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
