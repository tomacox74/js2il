          "uid": "t262-monitor-age",
          "title": "Test262 monitor-age",
          "condition": "C",
          "for": "15m",
          "noDataState": "NoData",
          "execErrState": "Error",
          "isPaused": true,
          "labels": {
            "service": "test262-catalogue",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Review operational signal monitor-age",
            "runbook_url": "https://github.com/tomacox74/js2il/blob/master/docs/ECMA262/Test262SupabaseCatalog.md#operational-monitoring-2341"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "dfdvmewbhyccga",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "grafana-postgresql-datasource",
                  "uid": "dfdvmewbhyccga"
                },
                "editorMode": "code",
                "format": "table",
                "rawQuery": true,
                "rawSql": "SELECT repository_id::text AS repository,breach::double precision AS value FROM test262_reporting.v_operational_signals WHERE signal='monitor-age' AND breach IS NOT NULL",
                "intervalMs": 1000,
                "maxDataPoints": 1000
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "conditions": [],
                "settings": {
                  "mode": "strict"
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
