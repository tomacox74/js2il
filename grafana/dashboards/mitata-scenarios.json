          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_run AS (\n  SELECT run_id, run_attempt\n  FROM public.perf_results\n  WHERE source = 'mitata' AND os_platform = 'linux'\n  ORDER BY run_at DESC\n  LIMIT 1\n), timings AS (\n  SELECT p.scenario, p.runtime, NULLIF(p.value, 0) AS avg_ns\n  FROM public.perf_results p\n  JOIN latest_run lr\n    ON p.run_id = lr.run_id\n   AND p.run_attempt = lr.run_attempt\n  WHERE p.source = 'mitata'\n    AND p.os_platform = 'linux'\n    AND p.metric = 'avg_ns'\n), runtime_times AS (\n  SELECT\n    scenario,\n    MAX(avg_ns) FILTER (WHERE runtime = 'jroc') AS jroc_ns,\n    MAX(avg_ns) FILTER (WHERE runtime = 'node') AS node_ns,\n    MAX(avg_ns) FILTER (WHERE runtime = 'clearscript') AS clearscript_ns,\n    MAX(avg_ns) FILTER (WHERE runtime = 'jint') AS jint_ns,\n    MAX(avg_ns) FILTER (WHERE runtime = 'okojo') AS okojo_ns,\n    MAX(avg_ns) FILTER (WHERE runtime = 'yantrajs') AS yantrajs_ns\n  FROM timings\n  GROUP BY scenario\n)\nSELECT\n  scenario AS \"Scenario\",\n  ROUND((jroc_ns / 1000000.0)::numeric, 3) AS \"JROC (ms)\",\n  ROUND((100.0 * CASE WHEN node_ns < jroc_ns THEN 1.0 - jroc_ns / node_ns ELSE node_ns / jroc_ns - 1.0 END)::numeric, 1) AS \"Node vs JROC\",\n  ROUND((100.0 * CASE WHEN clearscript_ns < jroc_ns THEN 1.0 - jroc_ns / clearscript_ns ELSE clearscript_ns / jroc_ns - 1.0 END)::numeric, 1) AS \"ClearScript vs JROC\",\n  ROUND((100.0 * CASE WHEN jint_ns < jroc_ns THEN 1.0 - jroc_ns / jint_ns ELSE jint_ns / jroc_ns - 1.0 END)::numeric, 1) AS \"Jint vs JROC\",\n  ROUND((100.0 * CASE WHEN okojo_ns < jroc_ns THEN 1.0 - jroc_ns / okojo_ns ELSE okojo_ns / jroc_ns - 1.0 END)::numeric, 1) AS \"Okojo vs JROC\",\n  ROUND((100.0 * CASE WHEN yantrajs_ns < jroc_ns THEN 1.0 - jroc_ns / yantrajs_ns ELSE yantrajs_ns / jroc_ns - 1.0 END)::numeric, 1) AS \"YantraJS vs JROC\"\nFROM runtime_times\nWHERE jroc_ns IS NOT NULL\nORDER BY scenario;",
          "refId": "A",
          "sql": {
