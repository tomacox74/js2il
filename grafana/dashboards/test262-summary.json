          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dfdvmewbhyccga"
          },
          "rawSql": "SELECT CASE WHEN sum(expected_observations)>0 THEN 100.0*sum(uploaded_observations)/sum(expected_observations) ELSE NULL END AS coverage FROM test262_reporting.v_catalogue_imports WHERE repository_id IN (${repository:sqlstring})",
