<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.12.37</Version>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- NuGet packaging -->
    <PackageId>Jroc.Runtime</PackageId>
    <Authors>tomacox74</Authors>
    <Company></Company>
    <Description>Runtime support library for executing and hosting JROC-compiled assemblies from .NET.</Description>
    <PackageProjectUrl>https://github.com/tomacox74/js2il/blob/master/docs/sdk/Index.md</PackageProjectUrl>
    <PackageReleaseNotes>Release history: https://github.com/tomacox74/js2il/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/tomacox74/js2il</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>javascript;js;il;dotnet;runtime;hosting</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Acornima" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Benchmarks" />
    <InternalsVisibleTo Include="Jroc.Tests" />
    <InternalsVisibleTo Include="Jroc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\Jroc.Runtime.NuGet.README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\icon.jpg" Pack="true" PackagePath="" />
    <None Update="Unicode-LICENSE.txt" Pack="true" PackagePath="licenses/Unicode-LICENSE.txt"
          TargetPath="licenses/Unicode-LICENSE.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Unicode-LICENSE.txt" LogicalName="JavaScriptRuntime.Unicode-LICENSE.txt" />
  </ItemGroup>

</Project>
