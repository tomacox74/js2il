        "feature": "Function/new Function with compile-time string literal parameter/body source",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-createdynamicfunction",
        "testScripts": [
          "tests/Jroc.Tests/Function/JavaScript/Function_Constructor_New_ConstantString_Basic.js",
