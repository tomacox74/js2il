        ],
        "test262Paths": [
          "test/built-ins/Reflect/has/return-boolean.js"
        ],
        "notes": "Performs the target [[HasProperty]] across own and inherited properties, matching the in operator, and throws a TypeError for non-object targets. Abrupt completions from property-key coercion are not yet covered."
      },
      {
        "clause": "28.1.9",
        "feature": "Reflect.isExtensible",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-reflect.isextensible",
