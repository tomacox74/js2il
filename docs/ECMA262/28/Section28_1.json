        ],
        "notes": "Reflect.defineProperty delegates to Object.defineProperty and returns true for successful descriptor definition. Current test262 coverage includes descriptor definition, symbol-keyed properties, length, name, Boolean result, and non-object-target rejection."
      },
      {
        "clause": "28.1.4",
        "feature": "Reflect.deleteProperty",
        "status": "Supported with Limitations",
