        ],
        "notes": "Reports the target [[IsExtensible]] state and throws a TypeError for non-object targets, unlike Object.isExtensible which coerces primitives to false. Proxy isExtensible trap invariants are not yet covered by checked-in tests."
      },
      {
        "clause": "28.1.11",
        "feature": "Reflect.preventExtensions",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-reflect.preventextensions",
