        ],
        "notes": "Supports three-argument assignment with Boolean success results across ordinary objects, arrays, TypedArrays, inherited descriptors, and proxy set traps. Explicit receiver semantics remain unsupported."
      },
      {
        "clause": "28.1.13",
        "feature": "Reflect.setPrototypeOf",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-reflect.setprototypeof",
