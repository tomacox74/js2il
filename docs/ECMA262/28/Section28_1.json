        "test262Paths": [
          "test/built-ins/Reflect/deleteProperty/delete-properties.js"
        ],
        "notes": "Performs the target [[Delete]] and reports the Boolean result rather than throwing for non-configurable properties, which is the observable difference from a strict-mode delete. Proxy deleteProperty traps are honored. PortNext100ExecutionTests covers deletion, Boolean result, and non-object-target rejection. Abrupt completions from property-key coercion are not yet covered."
      },
      {
        "clause": "28.1.5",
        "feature": "Reflect.get",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-reflect.get",
