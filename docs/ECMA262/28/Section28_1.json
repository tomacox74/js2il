        ],
        "test262Paths": [
          "test/built-ins/Reflect/getPrototypeOf/return-prototype.js"
        ],
        "notes": "Returns the target [[Prototype]] and throws a TypeError for non-object targets. Proxy getPrototypeOf traps are honored. Null-prototype and abrupt-completion cases are not yet covered by checked-in tests."
      },
      {
        "clause": "28.1.8",
        "feature": "Reflect.has",
        "status": "Supported with Limitations",
