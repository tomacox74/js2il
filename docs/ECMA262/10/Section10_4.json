          "tests/Jroc.Tests/Array/JavaScript/Array_Exotic_Sloppy_Assignment.js",
          "tests/Jroc.Test262.Tests/built-ins/Array/length/JavaScript/define-own-prop-length-overflow-order.js",
          "tests/Jroc.Test262.Tests/built-ins/Array/length/JavaScript/define-own-prop-length-no-value-order.js"
        ],
        "test262Paths": [
          "test/built-ins/Array/length/define-own-prop-length-coercion-order-set.js",
          "test/built-ins/Array/length/define-own-prop-length-coercion-order.js",
          "test/built-ins/Array/length/define-own-prop-length-overflow-order.js",
          "test/built-ins/Array/length/define-own-prop-length-no-value-order.js"
        ],
        "notes": "Canonical array indices use dedicated dense storage for ordinary elements and descriptor-backed sparse storage for exceptional indices. Indexed data/accessor descriptors, holes, deletion, non-writable length, failed highest-to-lowest truncation, strict/sloppy writes, maximum index boundaries, observable ToUint32/ToNumber coercion order, and preventExtensions/seal/freeze invariants are enforced through the Array [[DefineOwnProperty]] and ArraySetLength paths. ArraySpeciesCreate is implemented separately with the limitations below."
      },
      {
        "clause": "10.4.2.3",
        "feature": "Species-aware array result construction",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-arrayspeciescreate",
        "testScripts": [
          "tests/Jroc.Test262.Tests/built-ins/Array/prototype/slice/JavaScript/create-species.js",
          "tests/Jroc.Test262.Tests/built-ins/Array/prototype/slice/JavaScript/create-species-neg-zero.js",
          "tests/Jroc.Test262.Tests/built-ins/Array/prototype/slice/JavaScript/create-species-non-ctor.js",
          "tests/Jroc.Test262.Tests/built-ins/Array/prototype/filter/JavaScript/create-species-null.js",
          "tests/Jroc.Test262.Tests/built-ins/Array/prototype/splice/JavaScript/property-traps-order-with-species.js"
        ],
        "notes": "Array.ArraySpeciesCreate reads constructor and Symbol.species, defaults undefined/null species to an ordinary array, rejects non-constructors, and constructs custom species results with the requested length. It also recognizes another realm's intrinsic Array constructor. Array-producing methods including concat, filter, map, slice, splice, flat, and flatMap use this path. Broader constructor/proxy/realm behavior retains the limitations of the shared callable and object runtime."
      },
      {
        "clause": "10.4.3",
        "feature": "Boxed-string creation, indexed descriptors, and own keys",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-string-exotic-objects",
        "testScripts": [
          "tests/Jroc.Test262.Tests/built-ins/String/JavaScript/numeric-properties.js",
