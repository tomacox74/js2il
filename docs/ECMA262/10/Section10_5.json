        "clause": "10.5.3",
        "feature": "Proxy callable, descriptor, and extensibility integration",
        "status": "Supported with Limitations",
        "specUrl": "https://tc39.es/ecma262/#sec-proxy-object-internal-methods-and-internal-slots",
        "testScripts": [
          "tests/Jroc.Tests/Function/JavaScript/Function_CallableReflection_ProxyIntegration.js",
          "tests/Jroc.Test262.Tests/built-ins/Proxy/ExecutionTests.cs",
